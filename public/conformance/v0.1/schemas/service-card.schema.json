{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperactive.network/schemas/v0.1/service-card.schema.json",
  "title": "Hyperactive Web v0.1 Service Card",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "provider",
    "serviceURI",
    "adapterID",
    "supportedProtocols",
    "authRequired",
    "profiles",
    "profileData",
    "capabilities",
    "metadata"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "id": { "type": "string", "format": "uri" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "provider": { "type": "string", "minLength": 1 },
    "serviceURI": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://.+$" },
    "adapterID": { "type": "string", "minLength": 1 },
    "supportedProtocols": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "authRequired": { "type": "boolean" },
    "identity": { "$ref": "node-identity.schema.json" },
    "subject": { "$ref": "principal.schema.json" },
    "profiles": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "uniqueItems": true
    },
    "profileData": {
      "type": "object",
      "propertyNames": { "format": "uri" },
      "properties": {
        "https://hyperactive.network/profiles/human/v0.1": { "$ref": "human-profile.schema.json" }
      },
      "additionalProperties": { "type": "object" }
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "capability-link.schema.json" }
    },
    "metadata": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profiles": { "contains": { "const": "https://hyperactive.network/profiles/human/v0.1" } }
        }
      },
      "then": {
        "properties": {
          "profileData": { "required": ["https://hyperactive.network/profiles/human/v0.1"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profileData": { "required": ["https://hyperactive.network/profiles/human/v0.1"] }
        }
      },
      "then": {
        "properties": {
          "profiles": { "contains": { "const": "https://hyperactive.network/profiles/human/v0.1" } }
        }
      }
    }
  ],
  "additionalProperties": false
}
