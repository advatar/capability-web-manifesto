{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperactive.network/schemas/v0.1/human-profile.schema.json",
  "title": "Human Profile for Hyperactive Service Cards v0.1",
  "type": "object",
  "required": ["subject", "offers", "metadata"],
  "properties": {
    "subject": { "$ref": "principal.schema.json" },
    "mandate": { "$ref": "#/$defs/mandate" },
    "offers": {
      "type": "array",
      "items": { "$ref": "#/$defs/offer" }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "mandate": {
      "type": "object",
      "required": ["scope", "humanConfirmationRequired", "metadata"],
      "properties": {
        "credential": { "type": "string", "minLength": 1 },
        "scope": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "humanConfirmationRequired": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "commitment": {
      "type": "object",
      "required": ["stage", "required"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "fulfillment": {
      "type": "object",
      "required": ["modes", "humanCommitments"],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["human", "agent", "hybrid"] }
        },
        "humanCommitments": { "type": "array", "items": { "$ref": "#/$defs/commitment" } }
      },
      "additionalProperties": false
    },
    "price": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
        "currency": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "effect": { "type": "string" },
        "organization": { "type": "string" },
        "scope": { "type": "string" },
        "jurisdiction": { "type": "string" },
        "maximumValue": { "$ref": "#/$defs/price" },
        "validUntil": { "type": "string", "format": "date-time" },
        "credential": { "type": "string" }
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["negotiated", "open", "closed"] },
        "query": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://.+$" }
      },
      "additionalProperties": false
    },
    "assurance": {
      "type": "object",
      "required": ["claim", "metadata"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "jurisdiction": { "type": "string" },
        "specialty": { "type": "string" },
        "issuer": { "type": "string" },
        "credential": { "type": "string" },
        "validUntil": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "offer": {
      "type": "object",
      "required": ["rel", "fulfillment", "assurances", "metadata"],
      "properties": {
        "rel": { "type": "string", "minLength": 1 },
        "fulfillment": { "$ref": "#/$defs/fulfillment" },
        "authority": { "$ref": "#/$defs/authority" },
        "availability": { "$ref": "#/$defs/availability" },
        "assurances": { "type": "array", "items": { "$ref": "#/$defs/assurance" } },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
